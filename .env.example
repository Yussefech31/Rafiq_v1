# Anthropic API key for Claude
ANTHROPIC_API_KEY=sk-ant-...

# Embedding model (multilingual, Arabic+French capable)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# LLM model
LLM_MODEL=claude-sonnet-4-6

# Vector store backend: 'qdrant' or 'faiss'
VECTOR_STORE_BACKEND=faiss

# Qdrant settings (only if VECTOR_STORE_BACKEND=qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# FAISS persistence directory
FAISS_PERSIST_DIR=./data/faiss_index

# Confidence thresholds
CONFIDENCE_HIGH_THRESHOLD=0.85
CONFIDENCE_LOW_THRESHOLD=0.55
QA_MATCH_THRESHOLD=0.72

# QA store weight in fusion (0-1, higher = more weight on precedents)
QA_STORE_WEIGHT=0.6
DOCS_STORE_WEIGHT=0.4

# SQLite database path
SQLITE_DB_PATH=./data/rafiq.db

# Document output directory
DOCUMENTS_OUTPUT_DIR=./data/documents
